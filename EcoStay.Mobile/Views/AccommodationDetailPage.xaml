<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:EcoStay.Mobile.ViewModels"
    xmlns:components="clr-namespace:EcoStay.Mobile.Components"
    xmlns:models="clr-namespace:EcoStay.Mobile.Models"
    x:Class="EcoStay.Mobile.Views.AccommodationDetailPage"
    x:DataType="viewmodels:AccommodationDetailViewModel"
    Title="Property Details">

    <Grid RowDefinitions="*, Auto">
        
        <!-- Scrollable Details -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="16">
                
                <!-- Main Image -->
                <Border 
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    HeightRequest="240">
                    <Grid>
                        <Image 
                            Source="{Binding SelectedImage}" 
                            Aspect="AspectFill" 
                            HeightRequest="240" />
                        
                        <!-- Property Type & Rating Pill -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="14" VerticalOptions="Start">
                            <Border 
                                Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#CCFFFFFF"
                                Padding="8,4">
                                <Label 
                                    Text="{Binding Accommodation.FormattedPropertyType}" 
                                    FontSize="11" 
                                    FontAttributes="Bold" 
                                    TextColor="{StaticResource EcoPrimary}" />
                            </Border>

                            <!-- Wishlist, Compare & Share Quick Floating Buttons -->
                            <HorizontalStackLayout Grid.Column="2" Spacing="8">
                                <Button 
                                    Text="❤️"
                                    Command="{Binding ToggleWishlistCommand}"
                                    BackgroundColor="#CCFFFFFF"
                                    CornerRadius="20"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0" />
                                <Button 
                                    Text="⚖️"
                                    Command="{Binding ToggleCompareCommand}"
                                    BackgroundColor="#CCFFFFFF"
                                    CornerRadius="20"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0" />
                                <Button 
                                    Text="📤"
                                    Command="{Binding ShareStayCommand}"
                                    BackgroundColor="#CCFFFFFF"
                                    CornerRadius="20"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Thumbnail Gallery Row -->
                <CollectionView 
                    ItemsSource="{Binding Accommodation.Images}"
                    HeightRequest="70">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border 
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="90"
                                HeightRequest="65">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AccommodationDetailViewModel}}, Path=SelectImageCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding .}" Aspect="AspectFill" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Property Header Details -->
                <VerticalStackLayout Spacing="4">
                    <Label 
                        Text="{Binding Accommodation.Name}" 
                        FontSize="22" 
                        FontAttributes="Bold" 
                        TextColor="{StaticResource TextDark}" />

                    <Label 
                        Text="{Binding Accommodation.Location}" 
                        FontSize="13" 
                        TextColor="{StaticResource TextMuted}" />

                    <Label 
                        Text="{Binding Accommodation.CapacityDetails}" 
                        FontSize="12" 
                        FontAttributes="Bold" 
                        TextColor="{StaticResource EcoPrimary}" 
                        Margin="0,4,0,0" />
                </VerticalStackLayout>

                <!-- Map Directions Button -->
                <Button 
                    Text="🗺️ Get Driving Directions" 
                    Command="{Binding OpenMapDirectionsCommand}" 
                    Style="{StaticResource OutlineEcoButton}" 
                    HeightRequest="42" 
                    FontSize="12" />

                <!-- Description -->
                <Border Style="{StaticResource EcoCardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="About this Eco-Stay" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                        <Label Text="{Binding Accommodation.Description}" FontSize="13" TextColor="{StaticResource TextBody}" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <!-- 6-Pillar Sustainability Breakdown -->
                <components:SustainabilityCard BindingContext="{Binding Accommodation}" />

                <!-- Amenities Section -->
                <Border Style="{StaticResource EcoCardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Green Facilities &amp; Amenities" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                        <CollectionView ItemsSource="{Binding Accommodation.Amenities}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#E8F5E9" Padding="8,6">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="✓" TextColor="{StaticResource EcoPrimary}" FontSize="12" FontAttributes="Bold" />
                                            <Label Text="{Binding .}" FontSize="11" TextColor="{StaticResource EcoDark}" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Guest Reviews -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Verified Traveler Reviews" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                    <CollectionView ItemsSource="{Binding Reviews}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Review">
                                <Border Style="{StaticResource EcoCardBorder}" Padding="14" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding UserName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                                            <Label Grid.Column="1" Text="★★★★★" TextColor="#F59E0B" FontSize="12" />
                                        </Grid>
                                        <Label Text="{Binding Comment}" FontSize="12" TextColor="{StaticResource TextBody}" />
                                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#E8F5E9" Padding="8,4" Margin="0,4,0,0">
                                            <Label Text="{Binding SustainabilityComment}" FontSize="10" TextColor="{StaticResource EcoDark}" FontAttributes="Italic" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Sticky Booking Bar -->
        <Border 
            Grid.Row="1" 
            BackgroundColor="#FFFFFF" 
            Stroke="{StaticResource BorderLight}" 
            StrokeThickness="1" 
            Padding="16,12">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label 
                        Text="{Binding Accommodation.FormattedPriceWithUnit}" 
                        FontSize="18" 
                        FontAttributes="Bold" 
                        TextColor="{StaticResource TextDark}" />
                    <Label 
                        Text="Includes 100% Carbon Offset" 
                        FontSize="11" 
                        TextColor="{StaticResource EcoPrimary}" 
                        FontAttributes="Bold" />
                </VerticalStackLayout>

                <Button 
                    Grid.Column="1"
                    Text="Reserve Stay"
                    Command="{Binding OpenBookingCommand}"
                    Style="{StaticResource PrimaryEcoButton}"
                    HeightRequest="44"
                    Padding="20,0"
                    FontSize="13" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
