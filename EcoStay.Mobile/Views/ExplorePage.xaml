<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:EcoStay.Mobile.ViewModels"
    xmlns:components="clr-namespace:EcoStay.Mobile.Components"
    xmlns:models="clr-namespace:EcoStay.Mobile.Models"
    xmlns:views="clr-namespace:EcoStay.Mobile.Views"
    x:Class="EcoStay.Mobile.Views.ExplorePage"
    x:DataType="viewmodels:ExploreViewModel"
    Title="Explore">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Top Search Bar & Location Controls -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="8" BackgroundColor="#FFFFFF">
            <Border 
                StrokeShape="RoundRectangle 16"
                Stroke="{StaticResource BorderLight}"
                BackgroundColor="#F8FAF7"
                Padding="12,2">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" />
                    <Entry 
                        Grid.Column="1" 
                        Text="{Binding SearchLocation}" 
                        Placeholder="Search Indian destination or GPS" 
                        FontSize="13" 
                        ReturnCommand="{Binding SearchPlacesCommand}"
                        VerticalOptions="Center" />
                    <Button 
                        Grid.Column="2" 
                        Text="Go" 
                        Command="{Binding SearchPlacesCommand}" 
                        Style="{StaticResource PrimaryEcoButton}"
                        HeightRequest="32"
                        Padding="10,0"
                        FontSize="12" />
                </Grid>
            </Border>

            <!-- Action buttons: Use My Location & Filter Toggle -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                <Button 
                    Grid.Column="0"
                    Text="📍 Use My Location"
                    Command="{Binding UseMyLocationCommand}"
                    Style="{StaticResource OutlineEcoButton}"
                    HeightRequest="36"
                    FontSize="11"
                    HorizontalOptions="Start" />

                <Button 
                    Grid.Column="1"
                    Text="⚙️ Filters &amp; Sort"
                    Command="{Binding ToggleFilterPanelCommand}"
                    Style="{StaticResource OutlineEcoButton}"
                    HeightRequest="36"
                    FontSize="11" />
            </Grid>

            <!-- Inline Filter Drawer if open -->
            <Border 
                IsVisible="{Binding IsFilterOpen}"
                StrokeShape="RoundRectangle 16"
                Stroke="{StaticResource BorderEmerald}"
                BackgroundColor="#F0FDF4"
                Padding="14"
                Margin="0,6,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Refine Stays &amp; Dining" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource EcoDark}" />
                    
                    <!-- Min EcoScore Slider -->
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Minimum EcoScore" FontSize="11" TextColor="{StaticResource TextDark}" />
                            <Label Grid.Column="1" Text="{Binding MinEcoScore, StringFormat='{0:0}+'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource EcoPrimary}" />
                        </Grid>
                        <Slider Minimum="50" Maximum="100" Value="{Binding MinEcoScore}" MinimumTrackColor="{StaticResource EcoPrimary}" />
                    </VerticalStackLayout>

                    <!-- Max Budget Slider -->
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Max Budget (₹ INR/night)" FontSize="11" TextColor="{StaticResource TextDark}" />
                            <Label Grid.Column="1" Text="{Binding MaxBudget, StringFormat='₹{0:N0}'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource EcoPrimary}" />
                        </Grid>
                        <Slider Minimum="1500" Maximum="25000" Value="{Binding MaxBudget}" MinimumTrackColor="{StaticResource EcoPrimary}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,4,0,0">
                        <Button 
                            Grid.Column="0" 
                            Text="Apply Filters" 
                            Command="{Binding ApplyFiltersCommand}" 
                            Style="{StaticResource PrimaryEcoButton}" 
                            HeightRequest="36" 
                            FontSize="12" />
                        <Button 
                            Grid.Column="1" 
                            Text="Reset" 
                            Command="{Binding ResetFiltersCommand}" 
                            Style="{StaticResource OutlineEcoButton}" 
                            HeightRequest="36" 
                            FontSize="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- Stays vs Organic Dining Tabs -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" BackgroundColor="#FFFFFF" Padding="16,0,16,8">
            <Button 
                Grid.Column="0"
                Text="🏡 Eco Stays"
                Command="{Binding SwitchTabCommand}"
                CommandParameter="0"
                Style="{StaticResource PrimaryEcoButton}"
                HeightRequest="38"
                Margin="0,0,4,0" />

            <Button 
                Grid.Column="1"
                Text="🥗 Organic Dining"
                Command="{Binding SwitchTabCommand}"
                CommandParameter="1"
                Style="{StaticResource OutlineEcoButton}"
                HeightRequest="38"
                Margin="4,0,0,0" />
        </Grid>

        <!-- Results List Area -->
        <RefreshView 
            Grid.Row="2" 
            IsRefreshing="{Binding IsRefreshing}" 
            Command="{Binding SearchPlacesCommand}">
            
            <Grid Padding="16,8">
                
                <!-- Loading State -->
                <ActivityIndicator 
                    IsRunning="{Binding IsBusy}" 
                    IsVisible="{Binding IsBusy}" 
                    Color="{StaticResource EcoPrimary}" 
                    HeightRequest="40" 
                    VerticalOptions="Center" />

                <!-- Empty State -->
                <VerticalStackLayout 
                    IsVisible="{Binding IsEmpty}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    Padding="24">
                    <Label Text="🍃" FontSize="40" HorizontalTextAlignment="Center" />
                    <Label Text="No Verified Places Found" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextDark}" HorizontalTextAlignment="Center" />
                    <Label Text="Try expanding your search radius, adjusting budget filters, or searching another Indian destination." FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                    <Button 
                        Text="Reset Filters" 
                        Command="{Binding ResetFiltersCommand}" 
                        Style="{StaticResource OutlineEcoButton}"
                        HeightRequest="36"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Error State -->
                <VerticalStackLayout 
                    IsVisible="{Binding HasError}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10"
                    Padding="24">
                    <Label Text="⚠️" FontSize="36" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                    <Button 
                        Text="Retry Search" 
                        Command="{Binding SearchPlacesCommand}" 
                        Style="{StaticResource PrimaryEcoButton}"
                        HeightRequest="36"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Stays List (when SelectedTab == 0) -->
                <CollectionView 
                    ItemsSource="{Binding Stays}"
                    IsVisible="{Binding SelectedTab, Converter={x:Static views:ExplorePageConverters.IsZeroConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Accommodation">
                            <components:AccommodationCard>
                                <components:AccommodationCard.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExploreViewModel}}, Path=NavigateToAccommodationDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </components:AccommodationCard.GestureRecognizers>
                            </components:AccommodationCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Restaurants List (when SelectedTab == 1) -->
                <CollectionView 
                    ItemsSource="{Binding Restaurants}"
                    IsVisible="{Binding SelectedTab, Converter={x:Static views:ExplorePageConverters.IsOneConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Restaurant">
                            <components:RestaurantCard>
                                <components:RestaurantCard.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExploreViewModel}}, Path=NavigateToRestaurantDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </components:RestaurantCard.GestureRecognizers>
                            </components:RestaurantCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

        </RefreshView>

    </Grid>

</ContentPage>
