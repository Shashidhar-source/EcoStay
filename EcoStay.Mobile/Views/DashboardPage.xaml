<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:EcoStay.Mobile.ViewModels"
    xmlns:models="clr-namespace:EcoStay.Mobile.Models"
    x:Class="EcoStay.Mobile.Views.DashboardPage"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            
            <!-- User Header Card -->
            <Border Style="{StaticResource EcoCardBorder}" Padding="16">
                <Grid ColumnDefinitions="Auto, *">
                    <Border 
                        Grid.Column="0" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        WidthRequest="60" 
                        HeightRequest="60" 
                        Margin="0,0,12,0">
                        <Image Source="{Binding User.AvatarUrl}" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding User.Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#E8F5E9" Padding="6,2">
                                <Label Text="Level 3" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource EcoDark}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding User.Email}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Impact Metrics (Saved Stays & Carbon Offset) -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource EcoCardBorder}" BackgroundColor="#E8F5E9" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="WISHLIST STAYS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource EcoDark}" />
                        <Label Text="{Binding SavedStaysCount, StringFormat='{0} Stays'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource EcoDark}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource EcoCardBorder}" BackgroundColor="#E0F2FE" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CARBON OFFSET" FontSize="10" FontAttributes="Bold" TextColor="#0369A1" />
                        <Label Text="{Binding CarbonOffsetKg, StringFormat='{0} kg CO₂e'}" FontSize="20" FontAttributes="Bold" TextColor="#0369A1" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- My Reservations -->
            <VerticalStackLayout Spacing="10">
                <Label Text="My Reservations" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                <CollectionView ItemsSource="{Binding Reservations}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Booking">
                            <Border Style="{StaticResource EcoCardBorder}" Padding="14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border 
                                        Grid.Column="0" 
                                        StrokeShape="RoundRectangle 12" 
                                        StrokeThickness="0" 
                                        WidthRequest="70" 
                                        HeightRequest="70" 
                                        Margin="0,0,12,0">
                                        <Image Source="{Binding AccommodationImage}" Aspect="AspectFill" />
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding AccommodationName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextDark}" MaxLines="1" />
                                        <Label Text="{Binding CheckIn, StringFormat='Check-in: {0}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                            <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource EcoPrimary}" TextTransform="Uppercase" />
                                            <Label Grid.Column="1" Text="{Binding FormattedPrice}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Traveler Sustainability Profile -->
            <Border Style="{StaticResource EcoCardBorder}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Traveler Sustainability Profile" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                    <Label Text="Personalized preferences used to rank eco-stays." FontSize="12" TextColor="{StaticResource TextMuted}" />
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Prioritize 100% Solar &amp; Clean Energy" FontSize="12" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PreferSolar}" OnColor="{StaticResource EcoPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Zero Single-Use Plastic &amp; Bio-Compost" FontSize="12" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PreferZeroWaste}" OnColor="{StaticResource EcoPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Rainwater &amp; Bawadi Conservation" FontSize="12" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PreferRainwater}" OnColor="{StaticResource EcoPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
