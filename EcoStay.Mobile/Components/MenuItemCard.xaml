<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EcoStay.Mobile.Components.MenuItemCard">

    <Border 
        Style="{StaticResource EcoCardBorder}"
        Margin="0,0,0,10"
        Padding="14">
        
        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">
            
            <!-- Diet Icon (Veg 🥗 / Non-Veg 🍗) -->
            <Label 
                Grid.Column="0" 
                Grid.Row="0"
                Text="{Binding DietIcon}" 
                FontSize="16" 
                VerticalOptions="Center" 
                Margin="0,0,10,0" />

            <!-- Item Name & Category -->
            <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="2">
                <Label 
                    Text="{Binding Name}" 
                    FontSize="14" 
                    FontAttributes="Bold" 
                    TextColor="{StaticResource TextDark}" />
                <Label 
                    Text="{Binding DietLabel}" 
                    FontSize="11" 
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <!-- Price -->
            <Label 
                Grid.Column="2" 
                Grid.Row="0"
                Text="{Binding FormattedPrice}" 
                FontSize="14" 
                FontAttributes="Bold" 
                TextColor="{StaticResource EcoPrimary}" 
                VerticalOptions="Center" />

            <!-- Item Description if available -->
            <Label 
                Grid.Column="1" 
                Grid.ColumnSpan="2"
                Grid.Row="1"
                Text="{Binding Description}" 
                FontSize="12" 
                TextColor="{StaticResource TextBody}" 
                Margin="0,6,0,0" />

        </Grid>

    </Border>

</ContentView>
