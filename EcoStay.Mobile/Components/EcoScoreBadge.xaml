<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EcoStay.Mobile.Components.EcoScoreBadge"
    x:Name="ThisBadge">

    <Border 
        StrokeShape="RoundRectangle 12"
        Stroke="#A7F3D0"
        StrokeThickness="1"
        BackgroundColor="#E8F5E9"
        Padding="8,4"
        HorizontalOptions="Start"
        VerticalOptions="Center">
        
        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
            <!-- Eco Leaf Icon -->
            <Label 
                Text="🌱" 
                FontSize="12" 
                VerticalOptions="Center" />

            <Label 
                Text="EcoScore" 
                FontSize="11" 
                FontAttributes="Bold"
                TextColor="#1B5E20" 
                VerticalOptions="Center" />

            <Label 
                Text="{Binding Score, Source={x:Reference ThisBadge}}" 
                FontSize="12" 
                FontAttributes="Bold"
                TextColor="#1B5E20" 
                VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Border>

</ContentView>
