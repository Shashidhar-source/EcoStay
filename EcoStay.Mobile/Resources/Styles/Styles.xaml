<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base Page Style -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundPage}" />
    </Style>

    <!-- Navigation Bar Style -->
    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="BarTextColor" Value="{StaticResource TextDark}" />
    </Style>

    <!-- Shell Styling -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextDark}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextDark}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource TextLight}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TextMuted}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource EcoPrimary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource EcoPrimary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- Label Typography -->
    <Style TargetType="Label" x:Key="HeadlineLarge">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="HeadlineMedium">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="TitleSmall">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="BodyRegular">
        <Setter Property="TextColor" Value="{StaticResource TextBody}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="BodyMuted">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Label" x:Key="CaptionSmall">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- EcoStay Primary Button Style -->
    <Style TargetType="Button" x:Key="PrimaryEcoButton">
        <Setter Property="BackgroundColor" Value="{StaticResource EcoPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource TextInverse}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Outline Button Style -->
    <Style TargetType="Button" x:Key="OutlineEcoButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource EcoPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderEmerald}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Card Frame / Border Style -->
    <Style TargetType="Border" x:Key="EcoCardBorder">
        <Setter Property="Stroke" Value="{StaticResource BorderLight}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#10000000" Offset="0,4" Radius="8" Opacity="0.6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Input Entry Style -->
    <Style TargetType="Entry" x:Key="EcoEntry">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

</ResourceDictionary>
